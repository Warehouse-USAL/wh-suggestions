# wh-suggestions — environment variables
# Copy this file to .env and fill in real values (never commit .env)

# HTTP listen address
HTTP_ADDR=:8080

# Redis (the service's only datastore)
REDIS_ADDR=redis:6379

# Redpanda / Kafka — brokers, topic and consumer group
KAFKA_BROKERS=redpanda:9092
KAFKA_TOPIC=order.completed
KAFKA_GROUP_ID=wh-suggestions

# Must match wh-backend's JWT_SECRET (HS256, min 32 chars) — CHANGE IN PRODUCTION
JWT_SECRET=dev-secret-change-in-prod-min-32-chars
